{
  "name": "dds-ktx-parser",
  "version": "2.0.0",
  "description": "Parse DDS, KTX and KTX 2 textures, reading only the bytes needed, and decode BC1-BC7, uncompressed and HDR formats to RGBA. No dependencies; runs in Node, browsers and workers.",
  "main": "./dist/index.js",
  "module": "./dist/index.mjs",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.mjs",
      "require": "./dist/index.js"
    }
  },
  "sideEffects": false,
  "files": [
    "dist",
    "THIRD-PARTY-NOTICES.md"
  ],
  "scripts": {
    "build": "tsup",
    "test": "jest"
  },
  "keywords": [
    "dds",
    "ktx",
    "ktx2",
    "parser",
    "decoder",
    "bc1",
    "bc7",
    "bc6h",
    "texture"
  ],
  "author": "sh0c",
  "license": "MIT",
  "homepage": "https://github.com/sh0c/dds-ktx-parser",
  "bugs": {
    "url": "https://github.com/sh0c/dds-ktx-parser"
  },
  "repository": "github:sh0c/dds-ktx-parser",
  "devDependencies": {
    "@types/jest": "^29.5.11",
    "jest": "^29.7.0",
    "ts-jest": "^29.1.2",
    "ts-node": "^10.9.2",
    "tsup": "^8.0.1",
    "typescript": "^5.3.3"
  }
}
